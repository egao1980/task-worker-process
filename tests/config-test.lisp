(in-package #:task-worker-process/tests)

;;; 0.1.0 contract: supervisor construction, heap lookup and the default
;;; child command (src/supervisor.lisp). No child.

(deftest supervisor-defaults
  (let* ((queue (%queue))
         (registry (w:make-handler-registry))
         (s (w:make-process-supervisor queue registry)))
    (ok (w:process-supervisor-p s))
    (ok (eq queue (w:supervisor-queue s)))
    (ok (eq registry (w:supervisor-registry s)))
    (ok (eq :idle (w:supervisor-state s)))
    (ok (eql 30 (w:supervisor-lease-seconds s)))
    (ok (= 10 (w:supervisor-heartbeat-interval s)))
    (ok (stringp (w:supervisor-worker-id s)))
    (ok (string/= (w:supervisor-worker-id s)
                  (w:supervisor-worker-id (w:make-process-supervisor queue registry)))
        "fresh worker ids")
    (ok (uiop:directory-pathname-p (w:supervisor-work-directory s)))
    (ok (null (w:supervisor-running-jobs s)))
    (ok (equal "w-1" (w:supervisor-worker-id
                      (w:make-process-supervisor queue registry :worker-id "w-1"
                                                                :lease-seconds 6))))
    (ok (= 2 (w:supervisor-heartbeat-interval
              (w:make-process-supervisor queue registry :lease-seconds 6))))))

(deftest supervisor-argument-checks
  (let ((queue (%queue))
        (registry (w:make-handler-registry)))
    (ok (typep (%catch (lambda () (w:make-process-supervisor :not-a-queue registry)))
               'type-error))
    (ok (typep (%catch (lambda () (w:make-process-supervisor queue :not-a-registry)))
               'type-error))
    (dolist (case '((:heap-sizes ((:tiny . 0)))
                    (:heap-sizes ((:tiny . "256")))
                    (:heap-sizes (:tiny 256))
                    (:default-heap-mb 0)
                    (:lease-seconds 0)
                    (:lease-seconds 1.5)
                    (:heartbeat-interval 30)
                    (:heartbeat-interval 0)
                    (:poll-interval 0)
                    (:claim-interval -1)
                    (:cancel-grace -1)
                    (:lisp-command "sbcl")
                    (:source-registry 42)))
      (destructuring-bind (option value) case
        (let ((c (%catch (lambda () (w:make-process-supervisor queue registry option value)))))
          (ok (and (typep c 'w:worker-configuration-error)
                   (eq option (w:worker-configuration-error-option c))
                   (equal value (w:worker-configuration-error-value c)))
              (format nil "~s ~s is refused" option value)))))
    ;; USE-VALUE substitutes (checked again)
    (let* ((tries 0)
           (s (handler-bind ((w:worker-configuration-error
                               (lambda (c)
                                 (declare (ignore c))
                                 (incf tries)
                                 (use-value (if (= tries 1) -5 128)))))
                (w:make-process-supervisor queue registry :default-heap-mb 0))))
      (ok (= 2 tries))
      (ok (eql 128 (w:job-heap-mb s (q:job-status queue (%submit queue :x))))))))

(deftest heap-size-lookup
  (let* ((queue (%queue '(:tiny 1) '(:small 1) '(:other 1)))
         (s (w:make-process-supervisor queue (w:make-handler-registry)
                                       :heap-sizes '((:tiny . 256) (:small . 384))
                                       :default-heap-mb 512))
         (bare (w:make-process-supervisor queue (w:make-handler-registry)
                                          :heap-sizes '((:tiny . 256)))))
    (flet ((job (class) (q:job-status queue (%submit queue :x :resource-class class))))
      (ok (eql 256 (w:job-heap-mb s (job :tiny))))
      (ok (eql 384 (w:job-heap-mb s (job :small))))
      (ok (eql 512 (w:job-heap-mb s (job :other))) "a class not in the table")
      (ok (eql 512 (w:job-heap-mb s (job nil))) "no class")
      (ok (eql 256 (w:job-heap-mb bare (job :tiny))))
      (ok (null (w:job-heap-mb bare (job nil))) "no default: the Lisp chooses"))))

(deftest default-lisp-command-shape
  (let ((cmd (w:default-lisp-command 256 "/tmp/x/boot.lisp"))
        (no-size (w:default-lisp-command nil "/tmp/x/boot.lisp")))
    (ok (every #'stringp cmd))
    (ok (equal (uiop:native-namestring sb-ext:*runtime-pathname*) (first cmd)))
    (ok (equal (list "--core" (uiop:native-namestring sb-ext:*core-pathname*))
               (subseq cmd 1 3)))
    (ok (equal '("--dynamic-space-size" "256MB")
               (subseq (member "--dynamic-space-size" cmd :test #'equal) 0 2)))
    (ok (equal '("--load" "/tmp/x/boot.lisp") (last cmd 2)))
    (ok (member "--disable-debugger" cmd :test #'equal))
    (ok (member "--no-userinit" cmd :test #'equal))
    (ok (not (member "--dynamic-space-size" no-size :test #'equal)))
    (ok (= (length no-size) (- (length cmd) 2)))))
