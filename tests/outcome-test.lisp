(in-package #:task-worker-process/tests)

;;; 0.1.0 contract: outcomes, restarts and the job directory, with a
;;; LISP-COMMAND that runs a fake child (this SBCL with one --eval) instead of
;;; the child entry; the signal test alone uses /bin/sh and is skipped on Windows.

(deftest command-gets-heap-and-boot-file
  (let* ((queue (%queue))
         (calls '())
         (s (%supervisor queue
                         :lisp-command (lambda (heap-mb boot-file)
                                         (push (list heap-mb boot-file
                                                     (and (probe-file boot-file) t))
                                               calls)
                                         (%fake-argv :code 0)))))
    (%submit queue :echo :resource-class :tiny)
    (%submit queue :echo)
    (w:run-next-job s)
    (w:run-next-job s)
    (setf calls (reverse calls))
    (ok (= 2 (length calls)))
    (ok (eql *tiny-mb* (first (first calls))))
    (ok (eql *default-mb* (first (second calls))))
    (ok (every #'stringp (mapcar #'second calls)))
    (ok (every (lambda (c) (equal "boot.lisp" (file-namestring (second c)))) calls))
    (ok (every #'third calls) "boot.lisp is written before the launch")
    (ok (string/= (second (first calls)) (second (second calls)))
        "each launch has its own job directory")))

(deftest nonzero-exit-fails-the-job
  (let* ((queue (%queue))
         (seen nil)
         (s (%supervisor queue :lisp-command (%fake :say "hello from the child" :code 7)
                               :on-child-failure (lambda (c) (setf seen c))))
         (id (%submit queue :echo)))
    (let ((job (w:run-next-job s)))
      (ok (q:job-p job))
      (ok (equal id (q:job-id job)))
      (ok (eq :failed (q:job-state job))))
    (ok (eq :failed (%state queue id)))
    (ok (%contains (%failure queue id) "child failure (exit)" "exited with code 7"))
    (ok (typep seen 'w:child-failure))
    (when (typep seen 'w:child-failure)
      (ok (eq :exit (w:child-failure-reason seen)))
      (ok (eql 7 (w:child-failure-exit-code seen)))
      (ok (equal id (w:child-failure-job-id seen)))
      (ok (eq :echo (w:child-failure-kind seen)))
      (ok (search "hello from the child" (or (w:child-failure-log-tail seen) "")))
      (ok (equal (princ-to-string seen) (%failure queue id))
          "FAILURE is the condition's report"))
    (ok (null (w:supervisor-running-jobs s)))))

(deftest signalled-child
  #+(or windows win32) (skip "no POSIX signals on Windows")
  #-(or windows win32)
  (let* ((queue (%queue))
         (s (%supervisor queue :lisp-command (%sh "kill -9 $$")))
         (id (%submit queue :echo)))
    (w:run-next-job s)
    (ok (%contains (%failure queue id) "child failure (signal)" "killed by signal 9"))))

(deftest exit-zero-without-result
  (let* ((queue (%queue))
         (s (%supervisor queue :lisp-command (%sh "exit 0")))
         (id (%submit queue :echo)))
    (w:run-next-job s)
    (ok (%contains (%failure queue id) "child failure (no-result)"
                   "exited with code 0 without a result"))))

(deftest launch-failure
  (let* ((queue (%queue))
         (s (%supervisor queue :lisp-command
                         (lambda (heap-mb boot-file)
                           (declare (ignore heap-mb boot-file))
                           (list "/nonexistent/twp-test/lisp"))))
         (id (%submit queue :echo)))
    (w:run-next-job s)
    (ok (eq :failed (%state queue id)))
    (ok (%contains (%failure queue id) "child failure (launch-failed)" "could not start"))))

(deftest unwritable-payload
  (let* ((queue (%queue))
         (launches 0)
         (s (%supervisor queue :lisp-command (lambda (h b)
                                               (declare (ignore h b))
                                               (incf launches)
                                               (%fake-argv :code 0))))
         (table (let ((h (make-hash-table :test 'equal)))
                  (setf (gethash "k" h) 1)
                  h))
         (id (%submit queue :echo :payload table)))
    (w:run-next-job s)
    (ok (%contains (%failure queue id) "child failure (protocol-error)"))
    (ok (zerop launches) "no child is started")))

(deftest use-value-completes-the-job
  (let* ((queue (%queue))
         (s (%supervisor queue :lisp-command (%sh "exit 5")
                               :on-child-failure (lambda (c)
                                                   (declare (ignore c))
                                                   (use-value '(:substitute 1)))))
         (id (%submit queue :echo)))
    (w:run-next-job s)
    (ok (eq :completed (%state queue id)))
    (ok (equal '(:substitute 1) (q:job-result (q:job-status queue id))))))

(deftest retry-child-launches-again
  (let* ((queue (%queue))
         (launches 0)
         (failures 0)
         (s (%supervisor queue
                         :lisp-command (lambda (h b)
                                         (declare (ignore h b))
                                         (incf launches)
                                         (%fake-argv :code 4))
                         :on-child-failure (lambda (c)
                                             (declare (ignore c))
                                             (when (= 1 (incf failures))
                                               (invoke-restart 'w:retry-child)))))
         (id (%submit queue :echo)))
    (w:run-next-job s)
    (ok (= 2 launches))
    (ok (= 2 failures))
    (ok (eq :failed (%state queue id)) "declining the second time fails the job")
    (ok (= 1 (q:job-attempts (q:job-status queue id))) "the same claim")))

(deftest work-directories
  (let* ((queue (%queue))
         (dirs '())
         (cmd (lambda (h boot)
                (declare (ignore h))
                (push (uiop:pathname-directory-pathname boot) dirs)
                (%fake-argv :say "logged" :code 6)))
         (gone (%supervisor queue :lisp-command cmd))
         (kept (%supervisor queue :lisp-command cmd :keep-work-directories t))
         (id1 (%submit queue :echo :payload '(:n 1)))
         (id2 (%submit queue :echo :payload '(:n 2))))
    (declare (ignore id1))
    (w:run-next-job gone)
    (w:run-next-job kept)
    (destructuring-bind (kept-dir gone-dir) dirs
      (ok (null (probe-file gone-dir)) "deleted by default")
      (ok (probe-file kept-dir))
      (ok (uiop:subpathp kept-dir (w:supervisor-work-directory kept)))
      (ok (search "logged" (uiop:read-file-string (merge-pathnames "child.log" kept-dir))))
      (let ((request (with-open-file (in (merge-pathnames "request.sexp" kept-dir))
                       (with-standard-io-syntax
                         (let ((*read-eval* nil)) (read in))))))
        (ok (equal id2 (getf request :job-id)))
        (ok (eq :echo (getf request :kind)))
        (ok (equal '(:n 2) (getf request :payload)))
        (ok (equal (%h 'echo) (getf request :handler)))
        (ok (equal (list *fixture-system*) (getf request :systems))))
      (uiop:delete-directory-tree kept-dir :validate t :if-does-not-exist :ignore))))
